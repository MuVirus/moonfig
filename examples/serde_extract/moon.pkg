import {
  "MuVirus/moonfig/core" @config,
  "MuVirus/moonfig/core/format/json_format" @jsonfmt,
  "MuVirus/moonfig/serde_bridge",
  "moonbit-community/serde.mbt" @serde,
}

pkgtype(kind: "executable")

// `types_derive.mbt` is generated: `moon check` / `moon test` run the generator
// before compiling this package. Pin the version to the serde.mbt dependency in
// `moon.mod` so generated code matches the library it calls.
rule(
  name: "serde-derive",
  command: "moonx moonbit-community/serde.mbt@0.3.1/derive $input",
)

dev_build(rule: "serde-derive", input: "types.mbt", output: "types_derive.mbt")
